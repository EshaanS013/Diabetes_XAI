# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Secrets / local env
.env
.env.*
!.env.example
*.pem
*credentials*
*serviceAccount*
firebase*.json

# Data (large / licensed — keep docs and .gitkeep)
data/raw/**
!data/raw/.gitkeep
!data/raw/README.md
data/processed/**
!data/processed/.gitkeep

# Keep split indices for reproducibility
# data/splits tracked intentionally

# Large model binaries / experiment dumps (regenerable)
artifacts/models/**
!artifacts/models/.gitkeep
artifacts/production/**
!artifacts/production/.gitkeep
artifacts/experiments/**
!artifacts/experiments/.gitkeep
!artifacts/experiments/*.log

# Keep split indices under artifacts/splits
# (tracked)

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Notebooks checkpoints
.ipynb_checkpoints/

# Flutter generated
mobile/flutter_app/.dart_tool/
mobile/flutter_app/build/
mobile/flutter_app/.flutter-plugins
mobile/flutter_app/.flutter-plugins-dependencies
mobile/flutter_app/.packages

# Generic logs (allow experiment logs)
*.log
!artifacts/experiments/*.log
logs/
